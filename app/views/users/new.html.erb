<div style="background:#fff0f6; min-height:100vh;
padding:50px 20px; text-align:center;
font-family:Arial;">

  <h1 style="color:#c45b91;">🌸 Mi espacio</h1>

  <div style="background:white; max-width:420px;
  margin:30px auto; padding:35px;
  border-radius:20px;
  box-shadow:0 4px 15px #e8c5d5;">

    <h2 style="color:#a66bc1;">Crear una cuenta 💗</h2>

    <%= form_with model: @user, url: users_path do |form| %>
      <p>Nombre</p>
      <%= form.text_field :name,
      required: true, style:"width:90%; padding:12px;" %>

      <p>Correo electrónico</p>
      <%= form.email_field :email_address,
      required: true, style:"width:90%; padding:12px;" %>

      <p>Contraseña</p>
      <%= form.password_field :password,
      required: true, style:"width:90%; padding:12px;" %>

      <p>Confirmar contraseña</p>
      <%= form.password_field :password_confirmation,
      required: true, style:"width:90%; padding:12px;" %>

      <br><br>

      <%= form.submit "Crear mi cuenta",
      style:"background:#d88ab2; color:white;
      border:none; padding:13px 30px;
      border-radius:20px; cursor:pointer;" %>

    <% end %>

    <p>
      ¿Ya tienes una cuenta?
      <%= link_to "Iniciar sesión", new_session_path %>
    </p>

  </div>
</div>
